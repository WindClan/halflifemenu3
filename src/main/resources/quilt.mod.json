{
  "schema_version": 1,
  "quilt_loader": {
    "group": "windclan",
    "id": "halflifemenu",
    "version": "${version}",
    "metadata": {
      "name": "Half-Life Menu",
      "description": "This mod makes some Minecraft menus look like they are from Half Life (v1.1.1.1)",
      "contributors": {
        "Me!": "WindClan"
      },
      "contact": {
        "sources": "https://github.com/WindClan/halflifemenu3"
      },
      "icon": "assets/halflifemenu/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "depends": [
      {
        "id": "minecraft",
        "version": "~${minecraft_ver}"
      }
    ]
  },
  "mixin": [
    "halflifemenu.mixins.json"
  ]
}