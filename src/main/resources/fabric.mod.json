{
  "schemaVersion": 1,
  "id": "halflifemenu",
  "version": "${version}",
  "name": "Half-Life Menu",
  "description": "This mod makes some Minecraft menus look like they are from Half Life (v1.1.1.1)",
  "authors": ["WindClan"],
  "contact": {
    "sources": "https://github.com/WindClan/halflifemenu3"
  },
  "license": "MIT",
  "icon": "assets/halflifemenu/icon.png",
  "environment": "client",
  "mixins": [
    "halflifemenu.mixins.json"
  ],
  "depends": {
    "minecraft": "~${minecraft_ver}"
  }
}
